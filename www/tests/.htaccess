# /tests/.htaccess
# PHPUnit-тесты. На проде не нужны вообще (см. DEPLOY.md), но если
# каталог всё же залит — прямой HTTP-доступ к нему запрещён.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
